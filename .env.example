# Copia questo file in ".env" e inserisci i tuoi valori.
# Il file .env NON va mai caricato su GitHub (è già escluso da .gitignore).

# Stringa di connessione di MongoDB Atlas (Database > Connect > Drivers).
# Se la lasci vuota, in locale parte un database temporaneo con dati demo.
MONGODB_URI=

# Chiave segreta per firmare i token di accesso: una stringa lunga e casuale.
JWT_SECRET=

# Porta del server API in locale (il sito in locale gira sulla 5173)
API_PORT=5000
